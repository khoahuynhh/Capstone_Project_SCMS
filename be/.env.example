# Environment Configuration for Cloud Server
# Copy this file to .env and modify values as needed

# Application
DEBUG=False
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql://admin:admin123@postgres:5432/retail_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://redis:6379
REDIS_TTL=3600

# MQTT
MQTT_BROKER=mosquitto
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# Model Storage
MODEL_STORAGE_PATH=/app/models
MODEL_MAX_SIZE_MB=500
MODEL_RETENTION_DAYS=30

# Federated Learning
FL_AGGREGATION_INTERVAL_HOURS=24
FL_MIN_CLIENTS=2
FL_BYZANTINE_TOLERANCE=0.2
FL_AGGREGATION_METHOD=fedavg

# Privacy & Compliance
DATA_RETENTION_DAYS=90
FACE_IMAGE_RETENTION_HOURS=0
ANONYMIZE_CUSTOMER_DATA=True
GDPR_ENABLED=True

# Security
API_KEY_ENABLED=False
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
ADMIN_API_KEY=

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Monitoring
PROMETHEUS_ENABLED=True
METRICS_PORT=9090
LOG_LEVEL=INFO

# Training
AUTO_RETRAIN_ENABLED=True
RETRAIN_SCHEDULE_HOUR=2
MIN_TRANSACTIONS_FOR_RETRAIN=100

# A/B Testing
AB_TEST_ENABLED=True
AB_TEST_SPLIT_RATIO=0.5

# Recommendation
RECOMMENDATION_TOP_K=5
RECOMMENDATION_TIMEOUT_MS=200

# Analytics
ANALYTICS_AGGREGATION_INTERVAL_HOURS=1

# Edge Device Settings
EDGE_HEARTBEAT_INTERVAL_SECONDS=60
EDGE_OFFLINE_THRESHOLD_MINUTES=5
