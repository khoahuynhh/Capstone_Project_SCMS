# Edge device identity. Must match cloud stores/edge_devices data.
BRANCH_ID=HCM_Q1
BRANCH_NAME=Mart Quan 1
DEVICE_ID=EDGE_HCM_Q1_01

# Edge HTTP API
APP_NAME=Edge AI Retail - Edge Device
APP_VERSION=1.0.0
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8001

# Face attribute model
MODEL_STORAGE_PATH=./models
FACE_ATTR_MODEL_FILE=best_model_v2_embedder.onnx
INFERENCE_DEVICE=cpu

# Face preprocessor / detector
# Keep false to send the original image directly to the attribute model.
FACE_PREPROCESSING_ENABLED=false
# Only used when FACE_PREPROCESSING_ENABLED=true. Leave empty to use OpenCV Haar Cascade fallback.
FACE_DETECTION_MODEL_PATH=
FACE_DETECTION_CONFIDENCE=0.7

# MQTT heartbeat/status to cloud broker
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL=60
MQTT_BROKER=<cloud-mqtt-host>
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_QOS=1

# Logging
LOG_LEVEL=INFO
