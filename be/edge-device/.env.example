# Device Identity
BRANCH_ID=
BRANCH_NAME=""
DEVICE_ID=

# Application
APP_NAME="Edge AI Retail - Edge Device"
APP_VERSION=1.0.0
DEBUG=false

# API Server
API_HOST=0.0.0.0
API_PORT=8001

# Cloud Server
CLOUD_API=http://<cloud-api-host>:8000
CLOUD_API_KEY=<your-cloud-api-key>
CLOUD_API_TIMEOUT=30

# Redis Cache
REDIS_URL=redis://<redis-host>:6379
CACHE_TTL=3600

# Kafka
KAFKA_BOOTSTRAP_SERVERS=<broker-1:9092,broker-2:9092>
KAFKA_FACE_EVENTS_TOPIC=face_events

# MQTT
MQTT_BROKER=<mqtt-host>:1883
MQTT_PORT=1883
MQTT_USERNAME=<mqtt-username>
MQTT_PASSWORD=<mqtt-password>
MQTT_KEEPALIVE=60
MQTT_QOS=1

# Camera
CAMERA_ENABLED=true
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
CAMERA_MOCK=true

# Face Detection
FACE_DETECTION_ENABLED=true
FACE_MIN_SIZE=50
FACE_DETECTION_CONFIDENCE=0.7
FACE_DETECTION_MODEL_PATH=./models/face_detector.onnx

# Recommendation
RECOMMENDATION_ENABLED=true
RECOMMENDATION_TOP_K=5
RECOMMENDATION_MODEL_PATH=./models/recommender.onnx
RECOMMENDATION_TIMEOUT_MS=200

# Model Management
MODEL_STORAGE_PATH=./models
MODEL_AUTO_UPDATE=true
MODEL_UPDATE_CHECK_INTERVAL=3600

# Performance
INFERENCE_BATCH_SIZE=1
INFERENCE_DEVICE=cpu
MAX_CONCURRENT_INFERENCES=2

# Customer Interaction Simulation
CUSTOMER_WAIT_TIME_MIN=5.0
CUSTOMER_WAIT_TIME_MAX=15.0
PURCHASE_PROBABILITY=0.4
RECOMMENDATION_ACCEPTANCE_RATE=0.6

# Privacy & Consent
REQUIRE_CONSENT=true
STORE_FACE_IMAGES=false
ANONYMIZE_DATA=true

# Monitoring & Logging
METRICS_ENABLED=true
METRICS_PORT=9091
LOG_LEVEL=INFO

# Heartbeat
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL=60

# Data Sync
SYNC_ENABLED=true
SYNC_INTERVAL=300
SYNC_BATCH_SIZE=100

# Federated Learning
FL_ENABLED=true
FL_LOCAL_EPOCHS=1
FL_BATCH_SIZE=32
FL_LEARNING_RATE=0.01
